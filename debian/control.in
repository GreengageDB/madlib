Source: madlib
Maintainer: Greengage <greengage@greengagedb.org>
Section: database
Build-Depends: debhelper (>= 13),
	 cmake,
	 m4,
	 lsb-release,
	 python3,
	 python3-yaml,
	 greengage@GP_MAJORVERSION@

Package: greengage@GP_MAJORVERSION@-madlib
Priority: optional
Architecture: amd64
Depends: ${shlibs:Depends},
	 greengage@GP_MAJORVERSION@
Provides: madlib, madlib@GP_MAJORVERSION@
Replaces: madlib, madlib@GP_MAJORVERSION@
Description: Apache MADlib extension for Greengage@GP_MAJORVERSION@
	Apache MADlib is an Open-Source Library for Scalable in-Database
	Analytics. It provides data-parallel implementations of mathematical,
	statistical and machine learning methods for structured and
	unstructured data. Installed as a Greengage extension
	(CREATE EXTENSION madlib).
