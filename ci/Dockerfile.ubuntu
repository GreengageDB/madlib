# FILE:    ci/Dockerfile.ubuntu
# CONTEXT: Build madlib deb-package on Ubuntu <OS_VERSION> for Greengage <GREENGAGE_VERSION>
# PURPOSE: Multi-stage Docker build for MADlib

# hadolint global ignore=DL3008

ARG OS_VERSION=22.04
ARG GREENGAGE_VERSION=6
ARG GREENGAGE_REPO=https://greengagedb.org

FROM ubuntu:${OS_VERSION} AS base
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN useradd -md /home/gpadmin gpadmin
WORKDIR /home/gpadmin

ARG GREENGAGE_VERSION \
    GREENGAGE_REPO \
    DEBIAN_FRONTEND=noninteractive

RUN set -eux; \
    apt-get update -q; \
    apt-get install -y --no-install-recommends \
        build-essential \
        cmake \
        curl \
        ca-certificates \
        git \
        gnupg \
        m4 \
        python3 \
        python3-dev \
        python3-pip; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /var/cache/* /var/log/*

RUN set -eux; \
    OS_VER=$(. /etc/os-release && echo "$VERSION_ID"); \
    mkdir -p /etc/apt/keyrings; \
    curl -fsSL "${GREENGAGE_REPO}/repositories/gpg" \
        | gpg --dearmor -o /etc/apt/keyrings/greengagedb.gpg; \
    echo "deb [signed-by=/etc/apt/keyrings/greengagedb.gpg] ${GREENGAGE_REPO}/repositories/ubuntu/${OS_VER}/x86_64 greengagedb main" \
        > /etc/apt/sources.list.d/greengagedb.list; \
    apt-get update -q; \
    apt-get install -y --no-install-recommends "greengage${GREENGAGE_VERSION}"; \
    apt-get clean; \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

RUN pip3 install --break-system-packages --no-cache-dir \
    pyxb-x==1.2.6.1 \
    pyyaml==6.0.1 \
    || pip3 install --no-cache-dir \
    pyxb-x==1.2.6.1 \
    pyyaml==6.0.1

FROM base AS build

ARG GREENGAGE_VERSION

RUN mkdir deb-packages && chown gpadmin:gpadmin deb-packages
COPY --chown=gpadmin:gpadmin . src/

WORKDIR /home/gpadmin/src
USER gpadmin

RUN set -eux; \
    . "/opt/greengagedb/greengage${GREENGAGE_VERSION}/greengage_path.sh"; \
    PG_CONFIG="${GPHOME}/bin/pg_config"; \
    ./configure \
        "-DGREENGAGE_${GREENGAGE_VERSION}_PG_CONFIG=${PG_CONFIG}" \
        "-DGREENGAGE_MAJOR_VERSION=${GREENGAGE_VERSION}"; \
    make -j"$(nproc)" extension; \
    BUILD_DIR="build/src/ports/greengage/${GREENGAGE_VERSION}"; \
    PKGLIB_DIR=$("${PG_CONFIG}" --pkglibdir); \
    SHARE_DIR=$("${PG_CONFIG}" --sharedir); \
    GIT_TAG=$(git describe --tags --abbrev=0 2>/dev/null || echo "v0.0.0"); \
    VERSION=$(echo "${GIT_TAG}" | sed 's/^[^0-9]*//'); \
    STAGING=$(mktemp -d); \
    mkdir -p "${STAGING}/DEBIAN" \
             "${STAGING}${PKGLIB_DIR}" \
             "${STAGING}${SHARE_DIR}/extension" \
             "${STAGING}${SHARE_DIR}/madlib"; \
    cp "${BUILD_DIR}/lib/libmadlib.so"        "${STAGING}${PKGLIB_DIR}/"; \
    cp "${BUILD_DIR}/extension/madlib"*        "${STAGING}${SHARE_DIR}/extension/"; \
    cp -r "${BUILD_DIR}/modules"               "${STAGING}${SHARE_DIR}/madlib/"; \
    printf 'Package: madlib%s\nVersion: %s\nArchitecture: amd64\nMaintainer: dev@madlib.apache.org\nDepends: greengage%s\nDescription: Apache MADlib extension for Greengage %s\n' \
        "${GREENGAGE_VERSION}" "${VERSION}" "${GREENGAGE_VERSION}" "${GREENGAGE_VERSION}" \
        > "${STAGING}/DEBIAN/control"; \
    dpkg-deb --root-owner-group --build "${STAGING}" \
        "/home/gpadmin/deb-packages/madlib${GREENGAGE_VERSION}_${VERSION}_amd64.deb"

FROM base AS code
COPY --chown=gpadmin:gpadmin . src/
RUN rm -rf src/.git*

FROM base AS clean
USER gpadmin

COPY --from=code  /home/gpadmin/src          src
COPY --from=build /home/gpadmin/deb-packages deb-packages
